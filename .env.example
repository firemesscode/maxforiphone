# ===== Единственное, что нужно заполнить тебе =====

# 1. Токен Telegram-бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# 2. Публичный HTTPS-адрес, на котором крутится этот сервер.
#    Именно его бот пропишет как webhook (npm run set-webhook).
#    Пример: https://max-bridge.example.com
WEBHOOK_URL=https://your-domain.example.com

# ===== Остальное можно не трогать =====

# Порт локального сервера
PORT=8080

# Секрет для проверки, что запрос на webhook реально от Telegram
# (любая случайная строка; генерится автоматически если пусто)
WEBHOOK_SECRET=

# Ключ капчи (Yandex SmartCaptcha), который требует web.max.ru при входе.
# Берётся на странице входа web.max.ru: DevTools → элемент капчи → data-sitekey.
MAX_CAPTCHA_SITEKEY=

# Адрес WebSocket-шлюза мессенджера MAX.
# Меняется только если MAX переедет на другой домен.
MAX_WS_URL=wss://ws-api.oneme.ru/websocket

# Файл, где хранятся сессии пользователей (токены MAX)
SESSIONS_FILE=./data/sessions.json
